# Clave personal de NASA. Genérala en https://api.nasa.gov/
NASA_API_KEY=tu_api_key_de_nasa

# Puerto local para uvicorn
PORT=8000

# Redis (opcional). Si no se configura, se usa caché en memoria.
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Token para los endpoints administrativos de caché (opcional).
# Si queda vacío, esos endpoints responden 404.
CACHE_ADMIN_TOKEN=
